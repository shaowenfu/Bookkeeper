<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 只用于调用 DeepSeek API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 记账后弹结果通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 识别期间的短时前台服务：识别完立即退出 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".BookkeeperApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 分享截图到本 App -->
        <activity
            android:name=".capture.ShareImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 按需读屏：长按两个音量键（无障碍快捷方式）或点磁贴时截一次屏。不订阅屏幕事件 -->
        <service
            android:name=".capture.ScreenReaderService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_reader_service" />
        </service>

        <!-- 快速设置磁贴：备用入口 -->
        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_notify"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- 识别期间的短时前台服务：识别完立即退出 -->
        <service
            android:name=".recognize.RecognitionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".recognize.UndoReceiver"
            android:exported="false" />

        <!-- WorkManager 加急任务在 Android 11 及以下以前台服务运行，需要声明类型 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
